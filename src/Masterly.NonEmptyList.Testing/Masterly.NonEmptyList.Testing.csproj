<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>3.0.0</Version>
    <Authors>Ahmad Omar Al-Freihat</Authors>
    <Description>Test support for Masterly.NonEmptyList: CsCheck generators for every non-empty type, an AutoFixture customization, and the published law suite (functor, monad, fold and structural laws) so property-based tests can verify your own code and extensions.</Description>
    <PackageProjectUrl>https://github.com/a7mdfre7at/Masterly.NonEmptyList</PackageProjectUrl>
    <RepositoryUrl>https://github.com/a7mdfre7at/Masterly.NonEmptyList</RepositoryUrl>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageTags>NonEmptyList;Testing;CsCheck;AutoFixture;PropertyBasedTesting;Generators;Laws;DotNet;CSharp</PackageTags>
    <PackageIcon>repo_image.png</PackageIcon>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReleaseNotes>
v3.0.0:
- Initial release: NonEmptyGen (CsCheck), NonEmptyCustomization (AutoFixture), NonEmptyListLaws
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsCheck" Version="4.9.1" />
    <PackageReference Include="AutoFixture" Version="4.18.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsPackaging)' != 'true'">
    <ProjectReference Include="..\Masterly.NonEmptyList\Masterly.NonEmptyList.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsPackaging)' == 'true'">
    <PackageReference Include="Masterly.NonEmptyList" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.nuget.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\repo_image.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
