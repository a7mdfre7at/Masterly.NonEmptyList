<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>3.0.1</Version>
    <Authors>Ahmad Omar Al-Freihat</Authors>
    <Description>Newtonsoft.Json (Json.NET) converters for Masterly.NonEmptyList: NonEmptyList, ImmutableNonEmptyList, NonEmptySet, NonEmptyDictionary, ConstrainedList, NonEmptyString and [NonEmptyCollection]-generated types. Empty arrays are rejected at deserialization time.</Description>
    <PackageProjectUrl>https://github.com/a7mdfre7at/Masterly.NonEmptyList</PackageProjectUrl>
    <RepositoryUrl>https://github.com/a7mdfre7at/Masterly.NonEmptyList</RepositoryUrl>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageTags>NonEmptyList;Newtonsoft.Json;Json.NET;JsonConverter;Serialization;DotNet;CSharp</PackageTags>
    <PackageIcon>repo_image.png</PackageIcon>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReleaseNotes>
v3.0.1:
- New package icon: a pair of brackets around a single element

v3.0.0:
- Initial release: NonEmptyJsonConverter handles every non-empty type in one converter
- AddNonEmptyConverters() extension for JsonSerializerSettings
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsPackaging)' != 'true'">
    <ProjectReference Include="..\Masterly.NonEmptyList\Masterly.NonEmptyList.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsPackaging)' == 'true'">
    <PackageReference Include="Masterly.NonEmptyList" Version="3.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.nuget.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\repo_image.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
